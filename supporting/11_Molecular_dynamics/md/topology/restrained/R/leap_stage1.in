source leaprc.protein.ff14SB
source leaprc.gaff2
source leaprc.water.tip3p
loadamberparams /root/workspace/cqc-4-sulfamoylanilinium-dihydrogen-phosphate/md/ligand/sfa_anion_gaff2.frcmod
loadamberparams /root/workspace/cqc-4-sulfamoylanilinium-dihydrogen-phosphate/md/ligand/sfa_anion_repair.frcmod
SAN = loadmol2 /root/workspace/cqc-4-sulfamoylanilinium-dihydrogen-phosphate/md/ligand/sfa_anion.mol2
sys = loadpdb /root/cqc-sfa-md/systems/restrained/R/build/assembly.pdb
check sys
charge sys
saveamberparm sys /root/cqc-sfa-md/systems/restrained/R/build/dry.prmtop /root/cqc-sfa-md/systems/restrained/R/build/dry.inpcrd
solvateOct sys TIP3PBOX 10.0
charge sys
saveamberparm sys /root/cqc-sfa-md/systems/restrained/R/build/stage1.prmtop /root/cqc-sfa-md/systems/restrained/R/build/stage1.inpcrd
savepdb sys /root/cqc-sfa-md/systems/restrained/R/build/stage1.pdb
quit
