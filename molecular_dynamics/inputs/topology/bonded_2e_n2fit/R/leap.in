source leaprc.protein.ff14SB
source leaprc.gaff2
source leaprc.water.tip3p
addAtomTypes {
    { "M1" "Zn" "sp3" }
    { "Y1" "N" "sp3" }
    { "Y2" "N" "sp3" }
    { "Y3" "N" "sp3" }
    { "Y4" "N" "sp3" }
}
HD1 = loadmol2 /root/cqc-sfa-md/qm/gr/mcpb_2e/HD1.mol2
HD2 = loadmol2 /root/cqc-sfa-md/qm/gr/mcpb_2e/HD2.mol2
HE1 = loadmol2 /root/cqc-sfa-md/qm/gr/mcpb_2e/HE1.mol2
ZN1 = loadmol2 /root/cqc-sfa-md/qm/gr/mcpb_2e/ZN1.mol2
SN1 = loadmol2 /root/cqc-sfa-md/qm/gr/mcpb_2e/SN1.mol2
set HD1 head HD1.1.N
set HD1 tail HD1.1.C
set HD1.1 connect0 HD1.1.N
set HD1.1 connect1 HD1.1.C
set HD2 head HD2.1.N
set HD2 tail HD2.1.C
set HD2.1 connect0 HD2.1.N
set HD2.1 connect1 HD2.1.C
set HE1 head HE1.1.N
set HE1 tail HE1.1.C
set HE1.1 connect0 HE1.1.N
set HE1.1 connect1 HE1.1.C
loadamberparams /root/cqc-sfa-md/qm/gr/mcpb_2e/sfa_anion_gaff2.frcmod
loadamberparams /root/cqc-sfa-md/qm/gr/mcpb_2e/sfa_anion_repair.frcmod
loadamberparams /root/cqc-sfa-md/qm/gr/mcpb_2e/CA2_mcpbpy.frcmod
loadamberparams /root/cqc-sfa-md/systems/bonded_2e_n2fit/R/build/n2_terms.frcmod
sys = loadpdb /root/cqc-sfa-md/systems/bonded_2e_n2fit/R/build/assembly.pdb
bond sys.93.NE2 sys.260.ZN
bond sys.95.NE2 sys.260.ZN
bond sys.118.ND1 sys.260.ZN
bond sys.260.ZN sys.261.N2
check sys
charge sys
saveamberparm sys /root/cqc-sfa-md/systems/bonded_2e_n2fit/R/build/dry.prmtop /root/cqc-sfa-md/systems/bonded_2e_n2fit/R/build/dry.inpcrd
solvateOct sys TIP3PBOX 10.0
